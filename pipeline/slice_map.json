 "rules": {
  "K1": {
   "title": "Only fully verified investors can receive",
   "units": [
    "token_receive",
    "ir_verify",
    "ctr_read",
    "tir_read",
    "irs_read",
    "claim_issuer_valid",
    "identity_claims"
   ]
  },
  "K2": {
   "title": "Revocation must block receiving",
   "units": [
    "token_receive",
    "ir_revoke",
    "tir_remove",
    "claim_issuer_revoke",
    "identity_claims"
   ]
  },
  "K3": {
   "title": "Required claim topics list must not be empty",
   "units": [
    "token_receive",
    "ir_verify",
    "ctr_all"
   ]
  },
  "K4": {
   "title": "Expired KYC must not be accepted",
   "units": [
    "token_receive",
    "ir_verify",
    "claim_issuer_valid",
    "identity_claims"
   ]
  },
  "K5": {
   "title": "A sender who lost KYC cannot send",
   "units": [
    "token_sender",
    "ir_verify"
   ]
  },
  "J1": {
   "title": "No receiving in a restricted country",
   "units": [
    "token_receive",
    "ir_country",
    "irs_read",
    "compliance_check",
    "cr_check",
    "cr_config"
   ]
  },
  "J2": {
   "title": "A country change to a restricted one blocks future receiving",
   "units": [
    "token_receive",
    "ir_country",
    "irs_read",
    "cr_check"
   ]
  },
  "J3": {
   "title": "The country module must be bound and configured",
   "units": [
    "compliance_check",
    "compliance_admin",
    "cr_check",
    "cr_config"
   ]
  },
  "J4": {
   "title": "forcedTransfer to a restricted country must be classified, not blindly reported",
   "units": [
    "token_forced",
    "compliance_check",
    "compliance_notify",
    "cr_check",
    "cr_hooks"
   ]
  },
  "H1": {
   "title": "No identity may exceed the maximum",
   "units": [
    "token_receive",
    "compliance_check",
    "compliance_notify",
    "mb_check",
    "mb_actions",
    "mb_config"
   ]
  },
  "H2": {
   "title": "The cap is per identity, not per wallet",
   "units": [
    "token_receive",
    "ir_identity",
    "mb_check",
    "mb_actions"
   ]
  },
  "H3": {
   "title": "Tracked balance must equal the real balance (counter drift)",
   "units": [
    "token_balance_paths",
    "compliance_check",
    "compliance_notify",
    "compliance_admin",
    "mb_check",
    "mb_actions",
    "mb_preset"
   ]
  },
  "H4": {
   "title": "The maximum must be configured sensibly",
   "units": [
    "compliance_admin",
    "compliance_check",
    "mb_check",
    "mb_config"
   ]
  }
 }
}